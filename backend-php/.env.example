# Copie para .env e ajuste. Variáveis de ambiente do servidor têm prioridade sobre este arquivo.

APP_DEBUG=false

# Chave usada para assinar os tokens da equipe (JWT). Use um valor longo e aleatório.
# Para manter válidos os tokens emitidos pelo backend Python, use a mesma SECRET_KEY de lá.
SECRET_KEY=troque-por-um-valor-longo-e-aleatorio
ACCESS_TOKEN_EXPIRE_MINUTES=10080

DB_HOST=localhost
DB_PORT=3306
DB_NAME=vise
DB_USER=vise
DB_PASSWORD=

# Origens liberadas para o app web (Flutter web). "*" libera todas; ou liste separadas por vírgula.
CORS_ORIGINS=*

# Endereço público do app (Flutter web), usado para montar o link das salas: <URL>/?sala=CODIGO
PUBLIC_APP_URL=http://localhost:8081

# Preencha para liberar o instalador web em /install (crie tabelas, admin e dados demo).
# Apague o valor depois de instalar.
INSTALL_KEY=
